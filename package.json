{
  "name": "regen",
  "version": "0.3.3",
  "description": "A local, gamified work-rhythm and wellbeing plugin for Obsidian.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/loopman90/regen.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check-version": "node scripts/check-version.mjs",
    "test": "tsc -p tsconfig.test.json && node --test .tmp-tests/tests/*.test.js",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "productivity",
    "wellbeing",
    "gamification"
  ],
  "author": "Regen",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.0",
    "typescript": "^5.4.5"
  }
}
